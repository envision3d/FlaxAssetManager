# Flax build output
Binaries/
Cache/
Logs/
Output/
Screenshots/
*.HotReload.*

# Generated by Flax when creating script project files (machine-specific:
# absolute engine/project paths, platform + configuration macros). Regenerate
# locally via GenerateProjectFiles.sh or by opening the .flaxproj in the editor.
*.Gen.cs
*.csproj
*.sln
*.slnx
launchSettings.json

# IDE / editor settings
*.code-workspace
/.vscode/
/.idea/

# Local files
imgui.ini

# Visual Studio / MSBuild build artifacts
[Bb]in/
obj/
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*.suo
*.log
*.cache
*.lib
_UpgradeReport_Files/
*.bak
_ReSharper*/
[Tt]est[Rr]esult*
/packages/
Thumbs.db

# Third-party manifest catalogs and their scrapers are generated data that churns with the
# upstream sites (tens of MB). They belong to a separate catalog repository outside this plugin
# and must never be vendored into it.
/example_manifests/
/manifests/
/tools/

# The compatibility probe project is checked in on purpose (see compat/README.md). The generic
# *.csproj rule above is for the files Flax generates, so re-allow this one and keep its output out.
!compat/FlaxAssetManager.Compat.csproj
/compat/obj/
/compat/bin/

# Runtime state is NOT part of the plugin. SettingsService resolves every file it
# reads/writes against Globals.ProjectFolder (SettingsService.cs:35), i.e. the *host*
# project's Content/FlaxAssetManager: the sources list is the user's own choice of
# manifest URLs and installed-pack tracking is machine-local. The plugin ships none of
# them; they are recreated on demand. These entries only stop them from reappearing
# here when the plugin project is opened standalone for development.
Content/FlaxAssetManager/

# Python tooling
__pycache__/
*.pyc

# Local verification scaffolding
.verify/bin/
.verify/obj/
