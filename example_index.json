  "description": "An index manifest: it links other manifests instead of listing assets, so one URL is a table of contents the owner updates freely. The user picks which entries to add as sources.",
  "homepageUrl": "https://example.com",
  "website": "https://example.com",
  "manifestKind": "index",
  "entries": [
    {
      "sourceId": "com.example.textures",
