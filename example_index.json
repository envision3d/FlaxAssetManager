      "url": "https://example.com/manifests/textures.json",
      "website": "https://example.com",
      "description": "PBR texture sets",
      "tags": ["textures", "PBR"]
    },
    {
      "sourceId": "com.example.models",
      "sourceName": "Example models",
      "url": "https://example.com/manifests/models.json",
      "description": "Environment models, imported as .flax meshes on install",
      "tags": ["models"]
    },
    {
      "sourceId": "com.example.plugins",
      "sourceName": "Example plugin projects",
      "url": "https://example.com/manifests/plugins.json",
      "description": "Full plugin projects, installed by git clone - review before installing",
      "tags": ["plugins"]
    }
  ]
}
